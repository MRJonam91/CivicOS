{
  "name": "civicos",
  "version": "1.0.0",
  "description": "Standalone civic forms and notifications engine for public bodies: declarative schemas, citizen application lifecycle, multi-channel notifications (email, SMS, App IO mock) and open data export.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Manoj Rollo <fbxmano@gmail.com> (https://github.com/MRJonam91)",
  "homepage": "https://github.com/MRJonam91/CivicOS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRJonam91/CivicOS.git"
  },
  "bugs": {
    "url": "https://github.com/MRJonam91/CivicOS/issues"
  },
  "keywords": [
    "civicos",
    "civic-tech",
    "public-administration",
    "pubblica-amministrazione",
    "open-government",
    "forms-engine",
    "notifications",
    "open-data",
    "cad",
    "agid",
    "app-io",
    "interoperability",
    "typescript",
    "audit-trail"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "civicos": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.it.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MRJonam91"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/mrjonam"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/mrjonam"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/manorollo"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.7.3"
  }
}
